{"n":8.3,"v":60758,"e":[[1,1,"tt30223243","Sorette koi no hajimari jan yo",8.6,7937],[1,2,"tt32986933","Sorette uchûjin ja ne",8.1,6641],[1,3,"tt32986935","Babâ to babâ ga gekitotsu jan ka",7.8,6262],[1,4,"tt33478674","Tâbo Babâ o buttobasô",8.9,7100],[1,5,"tt33609039","Tama wa doko jan yo",8.2,5895],[1,6,"tt33609040","Yabê onna ga kita",8.1,5754],[1,7,"tt33609042","Yasashii sekai e",9.7,20990],[1,8,"tt33609043","Nanka moyamoya suru jan yo",8,5071],[1,9,"tt33609044","Gattai! Serupo Dôbâ Dêmon Nesshî!",8.4,5047],[1,10,"tt33609045","Kyatoru myûtirêshon o kimi wa mita ka",7.7,4278],[1,11,"tt33609046","Hatsukoi no hito",7.6,4098],[1,12,"tt33609047","Noroi no ie e rettsu gô",7.5,3973],[2,1,"tt35064040","Orochi densetsu tte korejan yo",7.7,3610],[2,2,"tt37520178","Jashi",8.8,4164],[2,3,"tt37539355","Yurusa nê ze",8.4,3377],[2,4,"tt37529078","Yabasugi jan yo",8.9,3780],[2,5,"tt37529079","Minna de otomari jan yo",8,2922],[2,6,"tt37529081","Kazoku ni narimashita",8.6,3395],[2,7,"tt37529082","Nanka moyamoya suru jan yo",8,2636],[2,8,"tt37529084","Ganbare Okarun",8.5,3108],[2,9,"tt37529083","Ie o tatenaoshitai",8.5,2702],[2,10,"tt37529085","Moteru hiketsu wa nanda",7.6,2392],[2,11,"tt37529086","Kaijû jan yo",7.9,2225],[2,12,"tt37529087","Gekitotsu! Uchû kaijû tai kyodai robo!",8.5,2418],[3,1,"tt38428633","Episode #3.1",null,null]]}