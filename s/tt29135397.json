{"n":6.7,"v":353,"e":[[1,1,"tt35047338","Sub rosa.",8.4,123],[1,2,"tt35273601","Exitus acta probat.",8.1,113],[1,3,"tt35341701","Quid faciam?",8.4,113],[1,4,"tt35341708","Acta est fabula.",8.1,118],[1,5,"tt35341709","Facta fugis, facienda petis.",8.7,109],[1,6,"tt35341711","Animum reges.",8.8,107],[1,7,"tt35341713","Post nubila Phoebus.",7.9,122],[1,8,"tt35341714","Belua multorum es capitum.",8.3,97],[1,9,"tt35341712","Ne vivam si abis.",8.3,95],[1,10,"tt35341718","Odi et amo.",8.2,102],[1,11,"tt35341721","Te ustus amen.",8.2,105],[1,12,"tt35341720","Fluctuat nec mergitur.",8.5,92],[1,13,"tt35341722","Per aspera ad astra.",8.9,93]]}