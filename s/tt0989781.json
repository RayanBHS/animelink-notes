{"n":5.8,"v":145,"e":[[1,1,"tt0992299","Nemureru gomi sute ba no purinsu",5.8,8],[1,2,"tt0992295","Chûbosu ochite kerai ga fueta",5.6,8],[1,3,"tt0992300","Oide mase makai hihôkan",5.2,8],[1,4,"tt1089343","Narikinjô no daikô sabaki!?",null,null],[1,5,"tt0992297","Giwaku no danjon... kamo shirenai",null,null],[1,6,"tt0992296","Etona no hazukashii himitsu",null,null],[1,7,"tt0992298","Makai kyôdai",null,null],[1,8,"tt0992301","Purinî no ichi ban nagai hi ssu!",null,null],[1,9,"tt0992302","Uchû senkan garuganchuwa",null,null],[1,10,"tt0992294","Asu no yuusha wa kimida!",null,null],[1,11,"tt0992293","Akai tsuki ga terasu yoru",null,null],[1,12,"tt0992292","Ai... Tatakai no hate ni",null,null]]}