{"n":6.4,"v":178,"e":[[1,1,"tt5360108","Tondemasu, Tondemasu yotsu!",6.6,8],[1,2,"tt7166220","Udon...?",6.5,7],[1,3,"tt7166216","Chotto Moete kita dake",6.5,7],[1,4,"tt9270520","O niku......Ureshii!",6.8,7],[1,5,"tt9270526","Un, ochitsuite ikou",6.7,7],[1,6,"tt9270532","Sore ga kimi no jitsuryoku kai?",6.8,7],[1,7,"tt9270536","Sasa reru mae ni sase!",7,7],[1,8,"tt9270542","Mo...Tobenai",7,7],[1,9,"tt9270548","Kotaeha sora ni aru ndesu!",7,7],[1,10,"tt9270552","Sore mo FC no tamedesu ka?",7,7],[1,11,"tt9270554","Watashi makenai!",7,7],[1,12,"tt9057222","Motto...tobou!!",7.1,8]]}