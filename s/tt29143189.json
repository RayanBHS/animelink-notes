{"n":6.4,"v":254,"e":[[1,1,"tt29313594","Taimurîpu shichatta a~!?",7.2,35],[1,2,"tt29471523","Issho ni bishôjo gêmu tsukuro!",7,32],[1,3,"tt29567481","Môichido minna ni aitakute!",7,23],[1,4,"tt29594122","Iin da yo!",7.3,22],[1,5,"tt29716228","2-do atta koto wa 3-do aru!",7.4,20],[1,6,"tt29894965","Konoha wo shinjite!",7.3,21],[1,7,"tt30003321","Ame futte ji katamaru",7.2,22],[1,8,"tt30028108","Ekô",7.4,22],[1,9,"tt30135537","Matane!",7.6,19],[1,10,"tt30228481","Seiippai yatte miru!",7.4,19],[1,11,"tt30325128","Orijinaru kyû",7.4,20],[1,12,"tt30428586","Yu, yuyuyuyuyu...",6.9,19],[1,13,"tt30505605","Watashi no taisetsu na mono",7.2,19]]}