{"n":6.5,"v":4219,"e":[[1,1,"tt8672792","Kill me... please.",7.2,159],[1,2,"tt8672794","Your grave is not here.",7,126],[1,3,"tt8684528","I swear to God.",7.2,120],[1,4,"tt8684530","A sinner has no right of choice.",7.4,124],[1,5,"tt8733136","Don't let me kill you just yet.",7.4,118],[1,6,"tt8733138","Zack is the only one who can kill me.",7.7,119],[1,7,"tt8733142","Who are you?",7.6,105],[1,8,"tt8733144","Yeah..., I'm a monster.",7.9,98],[1,9,"tt8733148","There is no God in this World.",7.6,96],[1,10,"tt8733150","The witch trial shall start.",7.1,98],[1,11,"tt8733152","'Cause you are my God, Zack.",7.6,98],[1,12,"tt8733154","Try to know everything about her.",8.1,98],[1,13,"tt8791450","I'm not Your God.",8.3,105],[1,14,"tt8791456","Swear you will be killed by me.",7.9,97],[1,15,"tt8791458","A vow cannot be stolen.",7.1,110],[1,16,"tt8791462","Stop crying and smile.",7.1,110]]}