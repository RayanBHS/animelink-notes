{"n":6.5,"v":4208,"e":[[1,1,"tt8672792","Kill me... please.",7.2,156],[1,2,"tt8672794","Your grave is not here.",7,124],[1,3,"tt8684528","I swear to God.",7.2,118],[1,4,"tt8684530","A sinner has no right of choice.",7.3,122],[1,5,"tt8733136","Don't let me kill you just yet.",7.4,116],[1,6,"tt8733138","Zack is the only one who can kill me.",7.7,117],[1,7,"tt8733142","Who are you?",7.7,103],[1,8,"tt8733144","Yeah..., I'm a monster.",8,96],[1,9,"tt8733148","There is no God in this World.",7.6,94],[1,10,"tt8733150","The witch trial shall start.",7.2,96],[1,11,"tt8733152","'Cause you are my God, Zack.",7.6,96],[1,12,"tt8733154","Try to know everything about her.",8.2,96],[1,13,"tt8791450","I'm not Your God.",8.3,103],[1,14,"tt8791456","Swear you will be killed by me.",8,95],[1,15,"tt8791458","A vow cannot be stolen.",8,108],[1,16,"tt8791462","Stop crying and smile.",8,108]]}