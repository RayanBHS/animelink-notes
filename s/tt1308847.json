{"n":6.5,"v":257,"e":[[1,1,"tt1316740","Waga ken wa ten no tame!",7.6,14],[1,2,"tt1323208","Ô wa ô o shiru!",7.3,10],[1,3,"tt1323207","Ware ni otosenu shiro wa nashi!",7.7,10],[1,4,"tt1323206","Kono ken, darega tame ni!",7.8,10],[1,5,"tt1323827","Sôkoku no kyôdai!",7.6,9],[1,6,"tt1323826","Oni, mezameru!",7.4,9],[1,7,"tt1325180","Aoki ôkami, daichi o karu!",7.8,9],[1,8,"tt1328981","Dôkoku, yami ni hibiku!",7.8,9],[1,9,"tt1333782","Onna no tatakai!",7.8,9],[1,10,"tt1336397","Nessa ni kudakeru ken!",8.1,9],[1,11,"tt1340144","Seitei, arawaru!",7.6,9],[1,12,"tt1346550","Ima otsuru ken'ôfu",7.1,9],[1,13,"tt1346922","Waga omomuku wa ten no michi!",8.3,10]]}