{"n":6.6,"v":134,"e":[[1,1,"tt0985322","Hadaka de donmai!",5.6,9],[1,2,"tt0985323","Maccho ga peropero!",null,null],[1,3,"tt0985324","Mizugi de taiji!",null,null],[1,4,"tt0988336","Yarasu no kappôchaku!",null,null],[1,5,"tt0988321","Keita to yôko!",null,null],[1,6,"tt0988329","Pittari tomohane!",null,null],[1,7,"tt0988322","Kon'yoku de saku saku!",null,null],[1,8,"tt0988323","Kosutte shippo!",null,null],[1,9,"tt0988316","Bonnô to sekuhata!",null,null],[1,10,"tt0988330","Sakura no omoide!",null,null],[1,11,"tt0988317","Guttari ni onegai!",null,null],[1,12,"tt0988333","Shinitai watashi no uta!",null,null],[1,13,"tt0988327","Ore ni wa omae no uta!",null,null],[1,14,"tt0988320","Kappa to otosan!",null,null],[1,15,"tt0988335","Uha uha keita ni on gaeshi!",null,null],[1,16,"tt0988318","Heya to kaidan to watashi!",null,null],[1,17,"tt0988326","Nanka mieteru!",null,null],[1,18,"tt0988324","Manmosu taihen!",null,null],[1,19,"tt0988325","Mokkori keita no omo tsubo!",null,null],[1,20,"tt0988334","Shirafu ni omoi wo!",null,null],[1,21,"tt0988332","Shikkari tomohane!",null,null],[1,22,"tt0988328","Papa to muko dono!",null,null],[1,23,"tt0988331","Shibomu zô san!",null,null],[1,24,"tt0988319","Kaoru to nadeshiko!",null,null],[1,25,"tt0988337","Zetsubô no utage!",null,null],[1,26,"tt1210227","Hikari!",null,null]]}