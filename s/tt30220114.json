{"n":7.1,"v":29,"e":[[1,1,"tt30224632","The misty beginnings",8.6,10],[1,2,"tt30224893","Midnight nightmares",8.9,10],[1,3,"tt30224898","Error 404",9,9],[2,1,"tt30224910","Radio silence",8.3,12],[2,2,"tt30224917","The Basement Circus",8.4,6],[2,3,"tt30224922","Stage Fright",null,null],[3,1,"tt30224927","We summoned a demon at 3am?! *VERY SCARY* (actually came?!)",null,null],[3,2,"tt30224933","Someone is running out of time",null,null],[3,3,"tt30224942","They never die a natural death",null,null],[4,1,"tt30225993","They never became older",null,null],[4,2,"tt30226004","Doomed to repeat it",null,null],[4,3,"tt30226010","It's because of you",null,null],[5,1,"tt30226024","More hurtful than anything that bleeds",null,null],[5,2,"tt30226033","Who reaps a harvest",null,null],[5,3,"tt30226044","Not a family at all",null,null],[6,1,"tt30226055","Where loneliness will be the glimmer",null,null],[6,2,"tt30226077","But you learn to live with them",null,null],[6,3,"tt30226089","Endings are not bad things",null,null]]}