{"n":7.9,"v":407,"e":[[1,1,"tt12457876","Seiki no magune. robotto kotetsu jigu",6.6,9],[1,2,"tt12457878","Chu yo tate birudo. appu!!",6.7,8],[1,3,"tt12457880","Shutsugen! genma yosai yamatanooroch",6.8,8],[1,4,"tt12457886","Hissatsu! mahha. doriru ni inochi wokakero",7,7],[1,5,"tt12457888","Muchakucha mekadon dai funsen",7.6,7],[1,6,"tt12457890","Shojo yo aruke ashita ni mutte!",null,null],[1,7,"tt12457894","Moe ru inochi wo shuto shiro",null,null],[1,8,"tt12457898","Otoko no taiketsu to yujo",null,null],[1,9,"tt12457908","Gekitotsu! biggu. shuta shutsugeki funo!",null,null],[1,10,"tt12457912","Ehon kara kie ta yukionna!",null,null],[1,11,"tt12457916","Shito! birudo. besu kobosen",null,null],[1,12,"tt12457922","Tae ro chu shori hao mae nomonoda!!",null,null],[1,13,"tt12457926","Hoe ru himika! jigoku no fukushu!",null,null],[1,14,"tt12457928","Mezame ro jigu ikari no hangeki!",null,null],[1,15,"tt12457932","Mekadon namida no kuchu hiko!",null,null],[1,16,"tt12457936","Saikyo maboroshi nin puresu sakusen",null,null],[1,17,"tt12457938","Ganbare! mekamekamekadon go",null,null],[1,18,"tt12457942","Kyofu! shinnyu suru kitsune hi!",null,null],[1,19,"tt12457950","Go? easofuso ho ma hi? ukusohe",null,null],[1,20,"tt12457954","Tatakae chu! kotetsu jigu ni chichi wo mita",null,null],[1,21,"tt12457956","Kesshi burakkuhoru karano dasshutsu",null,null],[1,22,"tt12457960","Gyakuten! toripuru faito!",null,null],[1,23,"tt12457962","Bakuha ichibyo mae! feri kyushutsusakusen",null,null],[1,24,"tt12457964","Shi wo yobu machi! boso suru moju!",null,null],[1,25,"tt12457966","Haha ga saken da birudo appu!",null,null],[1,26,"tt12457970","Shi wo kake te chikatta yakusoku",null,null],[1,27,"tt12457972","Makka ni moe ro! shin saibogu",null,null],[1,28,"tt12457976","Gyakushu! shinheiki pansaroido",null,null],[1,29,"tt12457980","Teio shutsugen! dotaku no nazo ga toke ta!",null,null],[1,30,"tt12457982","Kaiki! ryu ma teio no robotto kemono",null,null],[1,31,"tt12457988","Fujisan joku ichiman metoru!?",null,null],[1,32,"tt12457990","Himika ni sasage ru ikari no hanran!",null,null],[1,33,"tt12457994","Bakushi jigoku no nonsutoppuresu",null,null],[1,34,"tt12457996","Abunau shi jigu! kapuseru hasshin!",null,null],[1,35,"tt12457998","Subarashii kazoku wo mamore!",null,null],[1,36,"tt12458002","Hana ichirin nikaketa inochi!",null,null],[1,37,"tt12458004","Furora shogun ha teki ka mikata ka!?",null,null],[1,38,"tt12458010","Hyakumannen zenka ra kita shonen!",null,null],[1,39,"tt12458018","Haha ni sasage ru tatakai no uta",null,null],[1,40,"tt12458022","Kokoro wo musubu ai no pendanto",null,null],[1,41,"tt12458024","Jigu wo ijigen hakaba ni okuri kome",null,null],[1,42,"tt12458030","San o asari wosumi esu? ta bin a hoanoku?",null,null],[1,43,"tt12458032","Hangyakusha! furora shogun no saigo!",null,null],[1,44,"tt12458036","Kotetsu jigu tsui ryu ma teio!",null,null],[1,45,"tt12458040","Tate yusha! ashita naki soryokusen!",null,null],[1,46,"tt12458044","Kotetsu jigu shori no kiroku",null,null]]}