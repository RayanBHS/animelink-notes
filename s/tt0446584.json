{"n":5.9,"v":264,"e":[[1,1,"tt2164593","Sono ken wa nan no tame ni aru no desu",5.8,10],[1,2,"tt2164607","Yoroshiku ne, Oniichan",6.2,7],[1,3,"tt2164603","Watashi wa shinjitemasu",6.6,8],[1,4,"tt2164595","Sore wa omae na no ka",5.8,6],[1,5,"tt2164569","Ima, nante itta no?",5.8,6],[1,6,"tt2164565","Dare ni watashi no jama wa sasenain dakara",null,null],[1,7,"tt2164581","Nagusamete kureru no!?",7.2,6],[1,8,"tt2164571","Inochi no tôtôsa wo shiranu mono wa fukô da",null,null],[1,9,"tt2164599","Subete wa mari no tame ni",7,6],[1,10,"tt2164587","Oniisan nan desho!",null,null],[1,11,"tt2164573","Kono yo ni aru no wa shitsubô dake da",null,null],[1,12,"tt2164561","Boku ja dame nan da...",null,null],[1,13,"tt2164575","Mamoru mono...",7,6],[1,14,"tt2164567","Dôshite kotaete kudasasranai no desu",null,null],[1,15,"tt2164563","Daijôbu, ore ga iru",null,null],[1,16,"tt2164583","Nani mo sukuenai...",null,null],[1,17,"tt2164601","Sude ni omae no yogoreteiru",null,null],[1,18,"tt2164577","Minna wakattetanya",6.8,6],[1,19,"tt2164609","Zutto issho da yo",7.2,6],[1,20,"tt2164579","Mô, iiya...",6.8,6],[1,21,"tt2164585","Omae ga hitsuyô nan da",null,null],[1,22,"tt2164589","Sabishii no wa docchi!",null,null],[1,23,"tt2164591","Sayonara...",null,null],[1,24,"tt2164597","Subete no kecchaku wo tsukeru basho",null,null],[1,25,"tt2164559","Ayamachi ni kizukishi mono",null,null],[1,26,"tt2164605","Watashi-tachi no mirai on tame ni!",7,6]]}