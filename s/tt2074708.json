{"n":8,"v":378,"e":[[1,1,"tt13854722","You're Kyosuke..?",8.8,9],[1,2,"tt13854732","Thank you... Coach!",8.7,8],[1,3,"tt13854748","I'm Not Gonna Lose!",8.2,6],[1,4,"tt13854758","Me? What? Defender?",8.4,6],[1,5,"tt13854768","Running Away?",8.2,6],[1,6,"tt13854778","Why do you have to be a forward?",8.4,6],[1,7,"tt13854788","Don't Underestimate soccer! part 1",null,null],[1,8,"tt13854794","Don't Underestimate soccer! part 2",null,null],[1,9,"tt13854798","You're A Man! What are you cowering about?",null,null],[1,10,"tt13854802","I Can see it! I can clearly see it!",null,null],[1,11,"tt13854914","Kyosuke-kun is Akanegaoka's weakpoint?",null,null],[1,12,"tt13854916","Don't be taken by the posts!",null,null],[1,13,"tt13854924","Hot-headed mister!!",null,null],[1,14,"tt13854930","Everyone! Gather in the Locker Room!",null,null],[1,15,"tt13854936","What's That Shot?",null,null],[1,16,"tt13854938","This Is It! I Can't Take It Anymore!",null,null],[1,17,"tt13854940","I'll Drag You Out Right Now!",null,null],[1,18,"tt13854944","Something is Wrong With Rodrigo!",null,null],[1,19,"tt13854950","When I Said I'll Make It, I'll Make It!",null,null],[1,20,"tt13854952","Hesitating Is So Unlike You!",null,null],[1,21,"tt13855192","A Sore Loser!",null,null],[1,22,"tt13855196","What Are We Doing...",null,null],[1,23,"tt13855214","Open-air Bath?",null,null],[1,24,"tt13855216","You Guys Are Too Cocky!",null,null],[1,25,"tt13855230","I'm Going to Face The World of Soccer!",null,null],[1,26,"tt13855240","I've been waiting for this",null,null],[1,27,"tt13855248","Let the penalty shoot-out begin",null,null],[1,28,"tt13855256","Do what we always do?",null,null],[1,29,"tt13855260","Bring it on, Sergeant Chin!",null,null],[1,30,"tt13855270","I made it, Brother!",null,null],[1,31,"tt13855274","I don't feel excited at all",null,null],[1,32,"tt13855280","Kanou Kyosuke... I won't forgive you!",null,null],[1,33,"tt13855286","It can't be... Kanou's the captain!?",null,null],[1,34,"tt13855288","You're 10 years too early... Bird nest head!",null,null],[1,35,"tt13855292","Why did this have to Happen to Kyosuke-kun too!!",null,null],[1,36,"tt13855302","What are you doing, guys!",null,null],[1,37,"tt13855308","Isn't anyone else coming!?",null,null],[1,38,"tt13855320","Captain Esaka...!?",null,null],[1,39,"tt13855324","Eat and run woman! How long are you going to sleep?",null,null],[1,40,"tt13855332","I was finally able to come back...",null,null],[1,41,"tt13855342","T-Twelve Goals!?",8.6,6],[1,42,"tt13855344","Who's that? Sergeant Chin",null,null],[1,43,"tt13855352","Can you give me a little time to think?",null,null],[1,44,"tt13855364","Father I'm ok now",null,null],[1,45,"tt13855370","Come Bring it",null,null],[1,46,"tt13855374","Itemea Soccer?",null,null],[1,47,"tt13855384","Where do you plan on Taking me!?",null,null],[1,48,"tt13855386","You think I'm just gonna laze around here!",null,null],[1,49,"tt13855394","Can't you stay just a little while longer? Murakami!",null,null],[1,50,"tt13855402","I've been waiting for you, Kanou Kyosuke-!",8.4,6],[1,51,"tt13855442","Spirit Of Akanegaoka!",9.1,9],[1,52,"tt13855444","Come back soon, Kanou Kyosuke!!",8.7,8]]}