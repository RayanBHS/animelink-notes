{"n":7,"v":656,"e":[[1,1,"tt1169742","Watashi... namida, agechatta kara",6.5,25],[1,2,"tt1172465","Watashi... nani ga shitai no...",6.9,18],[1,3,"tt1206642","Dô natta? Konaida no hanashi",7.2,16],[1,4,"tt1206643","Hai, pachipachi tte shite",7.3,16],[1,5,"tt1206647","O-sekkai na otoko no ko tte baka mitai",7.1,16],[1,6,"tt1206648","Sore wa... nan no jôdan?",7.2,15],[1,7,"tt1206641","Chanto itte, koko ni kaite",7.3,16],[1,8,"tt1206649","Yuki ga futte inai machi",7.1,16],[1,9,"tt1206645","Naka naka tobenai ne...",7.2,16],[1,10,"tt1206650","Zenbu chanto suru kara",7,16],[1,11,"tt1206640","Anata ga suki na no wa watashi janai",7.1,16],[1,12,"tt1206646","Nani mo mitenai watashi no hitomi kara",7,16],[1,13,"tt1206644","Kimi no namida o",7.9,16]]}