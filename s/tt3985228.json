{"n":7.9,"v":1328,"e":[[1,1,"tt4552004","Ashita ni mukatte, Ekusodasu!",7.1,73],[1,2,"tt4552014","Arupin wa imasu!",7.2,68],[1,3,"tt4552024","Sôshûhen wa mô iya da",7.5,58],[1,4,"tt4552038","Watasha shippai koichimatte sa",7.6,59],[1,5,"tt4552048","Hito no sei ni shiteiru yôna yatsu wa yamechimae!",7.4,56],[1,6,"tt4552050","Idepon Miyamori: Hatsudô-hen",7.9,58],[1,7,"tt4552054","Neko de riteiku",7.5,57],[1,8,"tt4552058","Semeterun janai kara ne",7.4,55],[1,9,"tt4552060","Nani o tsutaetakattan da to omou?",7.6,53],[1,10,"tt4552066","Ato ippai dake ne",7.6,53],[1,11,"tt4552072","Genga uri no shôjo",7.8,55],[1,12,"tt4552070","Ekusodasu kurisumasu",8.6,63],[1,13,"tt4554568","Suki na kumotte nan desu ka?",7.4,54],[1,14,"tt4554570","Jinginaki ôdishon kaigi",7.6,52],[1,15,"tt4554576","Konna e de iin desu ka?",7.6,52],[1,16,"tt4554580","Chabudai gaeshi",8,55],[1,17,"tt4554582","Watashi doko ni irun deshô ka...",7.8,54],[1,18,"tt4554586","Ore o hameyagatta na!",7.6,53],[1,19,"tt4554590","Tsuremasu ka?",8.1,57],[1,20,"tt4554594","Ganbarimasutangu!",7.8,53],[1,21,"tt4554600","Kuoriti o hitojichi ni sunna",7.7,53],[1,22,"tt4554602","Noa wa shitagi desu.",8.1,53],[1,23,"tt4554608","Zoku chabudai gaeshi",9.1,75],[1,24,"tt4554612","Tôsugita nôhin",8.6,63]]}