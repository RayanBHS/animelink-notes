{"n":6.9,"v":1494,"e":[[1,1,"tt2848432","Ano ko wa kawaii mochiya no musume",6.8,70],[1,2,"tt2848430","Koi no hanasaku barentain",7.2,59],[1,3,"tt2848428","Kûru na ano ko ni acchicchi",7.4,58],[1,4,"tt2848426","Chîsana koi, saichatta",7.2,58],[1,5,"tt2848424","Ichiya o tomo ni sugoshita ze",7.2,55],[1,6,"tt2848422","Ore no sesuji mo kôtta ze",6.8,57],[1,7,"tt2848420","Ano ko ga oyome ni itchatta",7,55],[1,8,"tt2848418","Niwatori dato wa iwasenê",7,53],[1,9,"tt2848416","Utatchaunda, koi no uta",8.1,73],[1,10,"tt2848414","Ano ko no baton ni hana ga saku",7,52],[1,11,"tt2848412","Masaka ano ko ga purinsesu",7,55],[1,12,"tt2848410","Kotoshi mo mata kuretetta",7.5,58]]}