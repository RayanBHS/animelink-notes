{"n":8.3,"v":2905,"e":[[1,1,"tt1282185","Osukaru! Bara no sadame",7.9,106],[1,2,"tt1282183","Mae! Ôsutoria no chou",7.5,86],[1,3,"tt1282195","Berusaiyu ni hibana chiru",7.2,83],[1,4,"tt1282166","Bara to sake to takurami to...",7.7,74],[1,5,"tt1282179","Koukisa wo namida ni komete...",7.4,73],[1,6,"tt1282178","Kinu no doresu to borofuku",7.4,67],[1,7,"tt1282158","Ai no tegami wa dare no te de",7.7,67],[1,8,"tt1282196","Waga kokoro no Osukaru",7.9,69],[1,9,"tt1282173","Hi wa suzumi hi wa noboru",8.1,69],[1,10,"tt1282194","Utsukushii akuma Jannu",7.9,66],[1,11,"tt1282169","Fersen kitaguni he saru",7.8,62],[1,12,"tt1282177","Kettou no asa Osukaru wa...?",7.7,61],[1,13,"tt1282163","Arasu no kaze yo kotaete...",7.9,65],[1,14,"tt1282191","Tenshi no himitsu",7.7,61],[1,15,"tt1282168","Kajino no hakushaku fujin",7.6,59],[1,16,"tt1282171","Haha, sono hito no na wa...?",7.6,59],[1,17,"tt1282174","Ima meguriai no toki",7.7,59],[1,18,"tt1282192","Totsuzen Ikarusu no you ni",7.4,56],[1,19,"tt1282187","Sayonara imouto yo!",8.5,70],[1,20,"tt1282170","Feruzen nagori no rinbu",8.1,62],[1,21,"tt1282181","Kurobara wa yoru hiraku",7.6,59],[1,22,"tt1282180","Kubikazari wa fukitsu na kagayaki",7.8,56],[1,23,"tt1282197","Zuru kashikute takumashiku!",8.3,61],[1,24,"tt1282157","Aduu, watashi no seishun",8.3,63],[1,25,"tt1282176","Katakoi no menuetto",8.4,65],[1,26,"tt1282182","Kuroi kishi ni aitai!",7.6,56],[1,27,"tt1282190","Tatoe hikari wo ushinau tomo...",8.2,60],[1,28,"tt1282160","Andore, aoi remon",8.7,63],[1,29,"tt1282164","Aruki hajimeta ningyou",8.5,59],[1,30,"tt1282184","Omae wa hikari ore wa kage",8.2,53],[1,31,"tt1282172","Heiei ni saku rira no hana",8.3,54],[1,32,"tt1282162","Arashi no pureryûdo",8.4,62],[1,33,"tt1282189","Tasogare ni choushou wa naru",8,51],[1,34,"tt1282175","Ima, 'Tenisu kôto no chikai'",8.4,54],[1,35,"tt1282186","Osukaru, ima, subanare no toki",8.2,58],[1,36,"tt1282159","Aikotoba wa 'Sayonara'",8.4,55],[1,37,"tt1282165","Atsuki chikai no yoru ni",8.7,66],[1,38