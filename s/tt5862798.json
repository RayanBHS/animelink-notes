{"n":7.2,"v":1144,"e":[[1,1,"tt6074954","Nandaka honto ni nyûsha shita kibun desu!",7.7,56],[1,2,"tt6880166","Kore ga otona no nomikai......",8,50],[1,3,"tt6880178","Chikoku shitara dô narun darô",8.1,51],[1,4,"tt6880186","Hajimete no... okyûryô...",8.1,50],[1,5,"tt6880198","Son'na ni tomarikomun desu ka?",8,49],[1,6,"tt6880206","Hatsubai... chûshi to ka?",8.3,48],[1,7,"tt6880218","Shinjin no kyôiku wa shikkarishite kudasai",8.1,47],[1,8,"tt6880230","Natsuyasumi daaa!!",8,47],[1,9,"tt6880246","Shukkinshicha ikenain desu ka?",8.1,47],[1,10,"tt6880252","Seishaintte okyûryô o yasukusuru tame no hô no nukeana",8,47],[1,11,"tt6880266","Rîku gazô ga kinô, netto ni detemashita yo!",8,46],[1,12,"tt6880278","Hitotsu yume ga kanaimashita!",8.4,46],[1,13,"tt7088294","Watashi, shain ryokôtte hajimete nanode",8.3,38],[2,1,"tt7088296","Hazukashii tokoro o mirarete shimaimashita......",8,50],[2,2,"tt7088298","Kore jâ tada no kosupure da nyâ!",8.7,46],[2,3,"tt7166226","......Û, hazukashii!",8.2,42],[2,4,"tt7456594","Kono... nibuchin-me!",8.4,38],[2,5,"tt7456606","Ya, hen na toko sawaranai de yo!",8,39],[2,6,"tt7458686","Aa...... sugoi naa......",8.6,39],[2,7,"tt7464280","Sugoku atsui shisen o kanjiru",8.2,38],[2,8,"tt7734270","Meido kissa ga ii to ittan da yo",8.3,37],[2,9,"tt7734282","Shatsu kurai ki na yo!",8.1,37],[2,10,"tt7734288","Dondon riariti ga usuku natte ikun da yo",8.3,38],[2,11,"tt7734290","Kokoro ni nani ka kakaeteru no ka",8.4,39],[2,12,"tt7734294","Zehi katte kudasai ne!",8.9,44]]}