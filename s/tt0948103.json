{"n":8.3,"v":28373,"e":[[1,1,"tt0998686","Bust Through the Heavens with Your Drill!!",7.8,1326],[1,2,"tt1089342","Ore ga norutte ittenda!!",7.7,1146],[1,3,"tt1054299","Who Do You Think You Are, Having Two Faces!?",8.1,1131],[1,4,"tt1644102","Kao ga ôkerya erai no ka!?",6.4,1093],[1,5,"tt1644103","Ore ni wa sappari wakaranê!",7.4,1035],[1,6,"tt1644105","Temê ra zen'nin yu atari shi ya gare!!",6.9,1043],[1,7,"tt1644108","Sore wa omae ga yarunda yo!!",7.9,1003],[1,8,"tt1644104","Abayo, dachi kô",9.4,1920],[1,9,"tt1644106","Hitotte ittai nani desu ka?",8,979],[1,10,"tt1644107","Anikitte ittai dare desu ka?",7.7,939],[1,11,"tt1785140","Shimon, te o dokete",8.7,1179],[1,12,"tt1785146","Yôko-san, onegai ga arimasu.",7.4,912],[1,13,"tt1785133","Minasan, tân to meshiagare.",7.9,900],[1,14,"tt1785145","Mina-san, gokigen yô.",8.2,943],[1,15,"tt1785136","Watashi wa ashita e mukaimasu.",9.1,1289],[1,16,"tt1785132","Shôshû-hen",5.1,669],[1,17,"tt1785148","Anata wa nani mo wakatte inai",8.2,933],[1,18,"tt1785141","Kikasete morauzo kono sekai no nazô",8.2,884],[1,19,"tt1785144","Ikinokorun da don'na shudan o tsukatte mo",8.1,873],[1,20,"tt1785134","Kami wa doko made bokura o tamesu",8,858],[1,21,"tt1785147","Anata wa ikinokorukebi hito da",8.2,888],[1,22,"tt1785143","Sore ga boku no saigo no gimu da",8.7,986],[1,23,"tt1785139","Ikuzo saigo no tatakai da",8.1,895],[1,24,"tt1785137","Wasureru mono ka kono ippun' ichibiyô o",8.5,1001],[1,25,"tt1785135","Omae no ishi wa uketotta!",9,1226],[1,26,"tt1785138","Ikuze dachi kô",9.2,1334],[1,27,"tt1785142","Ten no hikari wa subete hoshi",9.5,1989]]}