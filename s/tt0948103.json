{"n":8.3,"v":28311,"e":[[1,1,"tt0998686","Bust Through the Heavens with Your Drill!!",7.8,1317],[1,2,"tt1089342","Ore ga norutte ittenda!!",7.7,1138],[1,3,"tt1054299","Who Do You Think You Are, Having Two Faces!?",8.1,1123],[1,4,"tt1644102","Kao ga ôkerya erai no ka!?",6.4,1085],[1,5,"tt1644103","Ore ni wa sappari wakaranê!",7.4,1029],[1,6,"tt1644105","Temê ra zen'nin yu atari shi ya gare!!",6.9,1034],[1,7,"tt1644108","Sore wa omae ga yarunda yo!!",7.8,997],[1,8,"tt1644104","Abayo, dachi kô",9.4,1905],[1,9,"tt1644106","Hitotte ittai nani desu ka?",8,971],[1,10,"tt1644107","Anikitte ittai dare desu ka?",7.7,931],[1,11,"tt1785140","Shimon, te o dokete",8.7,1170],[1,12,"tt1785146","Yôko-san, onegai ga arimasu.",7.4,902],[1,13,"tt1785133","Minasan, tân to meshiagare.",7.9,891],[1,14,"tt1785145","Mina-san, gokigen yô.",8.2,935],[1,15,"tt1785136","Watashi wa ashita e mukaimasu.",9.1,1275],[1,16,"tt1785132","Shôshû-hen",5.1,663],[1,17,"tt1785148","Anata wa nani mo wakatte inai",8.2,925],[1,18,"tt1785141","Kikasete morauzo kono sekai no nazô",8.2,876],[1,19,"tt1785144","Ikinokorun da don'na shudan o tsukatte mo",8.1,864],[1,20,"tt1785134","Kami wa doko made bokura o tamesu",8,849],[1,21,"tt1785147","Anata wa ikinokorukebi hito da",8.2,879],[1,22,"tt1785143","Sore ga boku no saigo no gimu da",8.7,976],[1,23,"tt1785139","Ikuzo saigo no tatakai da",8.1,886],[1,24,"tt1785137","Wasureru mono ka kono ippun' ichibiyô o",8.5,989],[1,25,"tt1785135","Omae no ishi wa uketotta!",9,1211],[1,26,"tt1785138","Ikuze dachi kô",9.2,1320],[1,27,"tt1785142","Ten no hikari wa subete hoshi",9.5,1973]]}