{"n":6.7,"v":85,"e":[[1,1,"tt0986059","Sora kara futtekita ôji sama!?",7.4,8],[1,2,"tt0986050","Ikinari, ojyama shimâsu!?",8.3,7],[1,3,"tt0986051","Kisu? Aka chan? Roripoppu!?",8.3,7],[1,4,"tt0986049","Doki doki onsen sekushî densetsu!?",8.8,6],[1,5,"tt0986058","Shichi gatsu jyu nana nichi no san",8.8,6],[1,6,"tt0986048","Chuukan shiken wa daipanikku!?",8.8,6],[1,7,"tt0986054","Natsu no gyouji wa choushigekiteki!?",8.8,6],[1,8,"tt0986055","Nina ga zero de, zero ga nina!?",8.8,6],[1,9,"tt0986052","Kon'yakusha, arawaru!?",8.8,6],[1,10,"tt0986060","Zero ando ichii: Deai to kizuna",8.8,6],[1,11,"tt0986056","Saigo no purezento!?",8.8,6],[1,12,"tt0986057","Sayonara suteki na ôji sama",8.8,6],[1,13,"tt0986053","Modotte! Mamotte! Roripoppu",8.8,6]]}