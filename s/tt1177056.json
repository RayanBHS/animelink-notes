{"n":6.8,"v":67,"e":[[1,1,"tt1178282","Hajimete no xxx",null,null],[1,2,"tt1178281","Hadaka no ojô sama",5.8,7],[1,3,"tt1178290","Watashi... uregoro?",null,null],[1,4,"tt1178286","Oyame kudasai, goshujin sama",null,null],[1,5,"tt1178280","Futari de shimasho",null,null],[1,6,"tt1178288","Saki ni abichaune",null,null],[1,7,"tt1178289","Shibarashiki ya, bara no kaori",null,null],[1,8,"tt1178291","Zenbu miechatteru!",null,null],[1,9,"tt1178287","Porori mo aruyo! Dôjin taikai",null,null],[1,10,"tt1178283","Konna ni nacchatta",null,null],[1,11,"tt1178285","Najimi tonjau",null,null],[1,12,"tt1178284","Mada mada yaritai, motto shitai",null,null]]}